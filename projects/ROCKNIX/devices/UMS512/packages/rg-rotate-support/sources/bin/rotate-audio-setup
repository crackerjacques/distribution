#!/bin/sh
# Speaker and microphone routing on sprdphone-sc2730, for ALSA users and
# anything that opens the card before PipeWire applies the UCM profile.
set -u
PATH=/usr/bin:/usr/sbin:/bin:/sbin
export PATH
C=${1:-0}
set_ctl() {
	name="$1"
	shift
	amixer -q -c "$C" cset name="$name" "$@" 2>/dev/null ||
		echo "rotate-audio-setup: could not set '$name'" >&2
}

# First: codec writes are silently dropped while the audio DSP is asleep.
set_ctl 'agdsp_access_en'                  on
set_ctl 'agdsp_access_a2dp_en'             on

# VBC / DSP profile. Silent at its default.
set_ctl 'DSP VBC Profile Select'           961216512
set_ctl 'VBC DAC0 AUD MDG Set'             1,1024
set_ctl 'VBC_DAC0_DP_EN'                   enable

# Without this hw:0,3 (FE_ST_FAST) fails to open with -EIO.
set_ctl 'S_FAST_P_CODEC SWITCH'            on
set_ctl 'VBC_MIXER0_DAC0'                  HALF_ADD
set_ctl 'VBC DAC0 DG Set'                  25,25

# codec DAC -> headphone mixers -> HP pins (the speaker path).
set_ctl 'DAC LRCLK Select'                 invert
set_ctl 'HP mix mode'                      0
set_ctl 'HPL Mixer DACLHPL Switch'         on
set_ctl 'HPR Mixer DACRHPR Switch'         on
set_ctl 'HPL EAR Sel'                      HPL
set_ctl 'Speaker Function'                 on
set_ctl 'Speaker1 Function'                on

# Analog gains, stock's idle values.
set_ctl 'Inter PA Config'                  303
set_ctl 'DAC Gain DAC Playback Volume'     3
set_ctl 'HPL Gain HPL Playback Volume'     4
set_ctl 'HPR Gain HPR Playback Volume'     4

# Main mic -> ADC0 -> VBC -> hw:0,2, mono on the left channel.
set_ctl 'Mic Function'                     on
set_ctl 'MICBIAS1 Power'                   on
set_ctl 'ADCL Mixer MainMICADCL Switch'    on
set_ctl 'AUD ADC0L Switch'                 on
set_ctl 'AUD ADC0R Switch'                 on
set_ctl 'ADC LRCLK Select'                 normal
set_ctl 'ag_iis1_ext_sel'                  enable
set_ctl 'ag_iis1_ext_sel_v1'               top_adc_iis0
set_ctl 'VBC_MUX_ADC0_SOURCE'              ADC_SOURCE_IIS
set_ctl 'VBC_MUX_ADC0'                     ADC_IN_IIS0_ADC
set_ctl 'VBC_MUX_ADC0_IIS_PORT_SEL'        VBC_IIS_PORT_IIS1
set_ctl 'VBC_MUX_AUDRCD01'                 AUDRCD_IN_ADC0
set_ctl 'VBC ADC0 DG Set'                  25,25
set_ctl 'VBC_ADC0_DP_EN'                   enable
set_ctl 'VBC_DSP_MAINMIC_PATH_SEL'         MAINMIC_FROM_LEFT
set_ctl 'S_CAPTURE_DSP_CODEC SWITCH'       on
set_ctl 'ADCL Gain ADCL Capture Volume'    8
set_ctl 'ADCR Gain ADCR Capture Volume'    8

